---
import { t, type Lang } from '../i18n/utils';
interface Props { lang: Lang; label?: string }
const { lang, label } = Astro.props;
---
{/* Lembrete de trabalho: só aparece em `npm run dev`, nunca no site publicado. */}
{import.meta.env.DEV && <span class="todo">{label ?? t(lang, 'pending')}</span>}
